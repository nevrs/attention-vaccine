{
  "manifest_version": 3,
  "name": "煽り注意報",
  "version": "0.12.0",
  "description": "怒りや不安をあおって稼ぐ、炎上を狙う、根拠を示さずに言い切る。読んでいる投稿や記事にこうした「手口」が使われていたら、‼️ で知らせます。どの立場の主張かは見ません。良し悪しの判断はあなたに任せます。判定基準も自分で設定できます。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*", "https://ai-gateway.vercel.sh/*", "https://api.openalex.org/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["checks.js", "sites.js", "content.js", "picker.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" }
}
