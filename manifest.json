{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "0.12.2",
  "description": "__MSG_extDescription__",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*", "https://ai-gateway.vercel.sh/*", "https://api.openalex.org/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["checks.js", "sites.js", "content.js", "picker.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": { "default_popup": "popup.html" }
}
